{
  "name": "weebhub-mobile-server",
  "main": "index.js",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev:start": "expo start -c",
    "dev:start:ios": "expo start -c --ios",
    "dev:start:android": "expo start -c --android",
    "dev:ios": "expo run:ios",
    "dev:ios:offline": "expo start -c --ios --offline",
    "dev:android": "expo run:android",
    "internal:dev:ios:device": "bash ./scripts/ios-device-build.sh",
    "internal:dev:android": "bash ./scripts/android-dev.sh dev",
    "internal:dev:android:install": "bash ./scripts/android-dev.sh install",
    "internal:dev:android:emulator": "bash ./scripts/android-dev.sh ensure-emulator",
    "internal:dev:android:start": "bash ./scripts/android-dev.sh start",
    "internal:dev:android:open": "bash ./scripts/android-dev.sh open",
    "internal:release:android": "bash ./scripts/android-build.sh",
    "internal:release:ios": "bash ./scripts/ios-build.sh",
    "internal:release:android:github": "bash ./scripts/publish-github-release.sh --platform android",
    "internal:release:ios:github": "bash ./scripts/publish-github-release.sh --platform ios",
    "internal:release:github": "bash ./scripts/publish-github-release.sh --platform all",
    "internal:ota:publish": "node ./tools/publish-ota-update.mjs",
    "internal:bump-version": "node ./tools/bump-version.mjs",
    "internal:build:server": "bash ./scripts/build-server.sh all",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "fix": "npx expo install --fix",
    "ios": "EXPO_OFFLINE=1 expo start -c --ios",
    "clean": "rm -rf .expo node_modules"
  },
  "dependencies": {
    "@rn-primitives/types": "~1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.40",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-network": "~55.0.16",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.24",
    "jotai": "^2.20.0",
    "lucide-react-native": "^0.562.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "1.0.7",
    "uniwind": "1.6.3"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "55.0.21",
    "expo-doctor": "^1.20.4",
    "typescript": "~5.9.2"
  }
}
